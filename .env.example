# Copier vers src/api/.env ou .env à la racine du projet
# Ne jamais committer de vraies clés.

COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=db-doc
COSMOS_CONTAINER=jobs

BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
BLOB_CONTAINER=doc-storage
